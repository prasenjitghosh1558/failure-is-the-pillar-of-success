# ==========================================
# NEXTRAK Intelligent Logistics Environment
# ==========================================

# Database: SQLite by default for zero-friction setup, or postgresql://user:password@localhost:5432/nextrak
DATABASE_URL="file:./dev.db"

# Authentication & Sessions
AUTH_SECRET="nextrak_super_secret_jwt_key_2026_production_grade"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Mapbox Geospatial & Routing
# Obtain from https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""
MAPBOX_ACCESS_TOKEN=""

# Shipment Tracking Providers
# AfterShip: https://www.aftership.com/
AFTERSHIP_API_KEY=""
# EasyPost: https://www.easypost.com/
EASYPOST_API_KEY=""

# Fleet Telematics Providers
# Samsara: https://www.samsara.com/
SAMSARA_API_TOKEN=""
# Geotab: https://www.geotab.com/
GEOTAB_USERNAME=""
GEOTAB_PASSWORD=""

# Email Notifications
# Resend: https://resend.com/
RESEND_API_KEY=""

# Platform Mode
DEMO_MODE="true"

